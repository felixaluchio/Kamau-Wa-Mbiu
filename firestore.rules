rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Events & Campaign Events collections for rallies, photo galleries, and video broadcasts
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /campaign_events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
